# Agience Mantle — local deploy config.
# Copy to .env (gitignored), then:  docker compose up -d
# Every value below has a sensible standalone default in compose.yaml; .env just
# overrides them. Leaving .env identical to this file is a working local deploy.

# Token issuer Mantle verifies against. MUST match the value the init container
# stamps into the authority manifest. Standalone = self-referential.
AUTHORITY_ISSUER=http://localhost:8081
ORIGIN_URI=http://localhost:8081

# Extra OIDC issuers Mantle trusts directly, as a JSON array (Entra/Auth0/Okta/...).
# Empty = platform-only. Each entry: {"issuer","audience","jwks_uri"|"jwks"}.
AGIENCE_TRUSTED_ISSUERS=

# Vector search: point at a /embed endpoint to enable kNN; empty = lexical-only.
EMBEDDINGS_PROVIDER=agience
EMBEDDINGS_URI=

# Auth to the embeddings host (Prism). Without one of these the /embed call is 401,
# no vectors are stored (search stays lexical; GET /artifacts/{id}/embedding 404s).
#   Static API key (simplest):
# EMBEDDINGS_API_KEY=
#   OR a self-signed service JWT (the host must trust THIS Mantle's signing key):
# EMBEDDINGS_JWT_AUDIENCE=prism

# Shared kernel build spec. The vendored wheel in vendor/ is preferred; this is the
# fallback when no wheel is present. Uncomment to override the build source.
# AGIENCE_KERNEL_SPEC=agience-kernel @ git+https://github.com/Agience/agience-origin.git@kernel-v0.1.0#subdirectory=src/kernel
